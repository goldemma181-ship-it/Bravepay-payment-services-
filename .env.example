# BRAVE — environment configuration
# Copy the relevant values into your host's dashboard (Render/Railway → Environment)
# or into a .env file next to docker-compose.yml. NEVER commit real keys to git.

# ── Required ──────────────────────────────────────────────
# Admin dashboard token (16+ chars). Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# Public URL of the site (no trailing slash) — used for Paystack callbacks and email links
# e.g. https://brave-social.onrender.com
PUBLIC_BASE_URL=

# ── Payments (optional — bank transfer works without these) ──
# From Paystack dashboard → Settings → API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Bank details shown to customers for transfer payments
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# ── Email receipts via Brevo (optional) ──────────────────
# brevo.com → SMTP & API → SMTP credentials
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a verified sender in Brevo, e.g. "BRAVE <hello@yourdomain.com>"
EMAIL_FROM=
# Where "new order" alerts go (can be same as EMAIL_FROM address)
OWNER_EMAIL=

# ── Optional extras ──────────────────────────────────────
# New-order webhook → Telegram bot / Make.com / n8n / Zapier (HTTPS URL)
ADMIN_WEBHOOK_URL=
# Optional shared secret; deliveries get an X-BRAVE-Signature: sha256=<hmac> header
ADMIN_WEBHOOK_SECRET=
# NGN per USD conversion for the catalog (default 1332)
NGN_PER_USD=
# Behind a reverse proxy (nginx/Caddy/Cloudflare)? Set to 1
TRUST_PROXY=
# Extra admin tokens for a team, comma-separated
ADMIN_TOKENS=

# ── Auto-fulfillment via supplier panel (optional) ─────────
# Standard SMM panel API v2 (POST {key, action:add|status, ...} to /api/v2)
# PANEL_API_URL=https://your-panel.com/api/v2
# PANEL_API_KEY=your-panel-key
# Our catalog id → the panel's service id (comma-separated; unmapped services stay manual)
# PANEL_SERVICES=ig-followers:1001,ig-likes:1002,tt-followers:2001
# Real per-1000 wholesale cost per service in USD (overrides catalog estimates in the profit report)
# PANEL_COSTS=ig-followers:1.0,tt-likes:0.5
